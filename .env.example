# JobScorer — environment variable contract (names only, no values).
# Copy to .env and fill in. See plans/production-readiness-audit.md for context.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management-API token for Supabase CLI/MCP only — local dev, never set in Vercel runtime.
SUPABASE_ACCESS_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=

# --- Upstash Redis (rate limiting + caching) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Razorpay (billing) ---
# TEST-mode keys/plan IDs during beta — see src/lib/billing-plans.ts
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- n8n orchestration (server-side only; do NOT prefix with NEXT_PUBLIC_) ---
N8N_RESUME_WEBHOOK_URL=
N8N_JOB_INGESTION_WEBHOOK_URL=
N8N_SCORING_WEBHOOK_URL=
N8N_COMPANY_RESEARCH_WEBHOOK=
N8N_OPTIMIZE_WEBHOOK_URL=
N8N_LEARNING_PATH_WEBHOOK_URL=
N8N_BUILD_PLAN_WEBHOOK_URL=
N8N_ROADMAP_WEBHOOK_URL=
N8N_PROJECT_EVIDENCE_WEBHOOK_URL=
N8N_COVER_LETTER_WEBHOOK_URL=
N8N_QUEUE_WAKE_URL=
N8N_QUEUE_MODE=
# Shared secret n8n sends back in X-Internal-Token to /api/rag/* routes.
N8N_INTERNAL_TOKEN=

# --- Trigger.dev (scoring fallback) ---
TRIGGER_SECRET_KEY=
TRIGGER_DEV_SCORING=

# --- Admin/internal auth ---
# Distinct high-entropy bearer for /api/admin/* and /api/rag/backfill — never the
# service-role key. See src/lib/adminAuth.ts.
ADMIN_API_TOKEN=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Site / misc ---
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ASSISTANT_MODE=
