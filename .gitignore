# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only smoke-test scripts (may contain test creds)
/scripts/

# dev/brainstorm artefacts — not source code
.superpowers/
.dev.log
response.txt
rendercv/
new_n8n.json
*.html.bak

.vercel

.trigger

# design-sync build output (regenerated by /design-sync; not source)
ds-bundle/
.ds-sync/
.design-sync/.cache/
node_modules/jobscorer/

# nested git worktrees created by agent sessions — not project source
.claude/worktrees/